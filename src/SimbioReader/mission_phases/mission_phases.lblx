<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://pds.nasa.gov/pds4/pds/v1/PDS4_PDS_1M00.sch" schematypens="http://purl.oclc.org/dsdl/schematron"?>

<Product_Ancillary
  xmlns="http://pds.nasa.gov/pds4/pds/v1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://pds.nasa.gov/pds4/pds/v1 https://pds.nasa.gov/pds4/pds/v1/PDS4_PDS_1M00.xsd">

    <Identification_Area>
        <logical_identifier>urn:esa:psa:bc:miscellaneous:mission_phases</logical_identifier>
        <version_id>1.3</version_id>
        <title>BepiColombo Mission Phases</title>
        <information_model_version>1.22.0.0</information_model_version>
        <product_class>Product_Ancillary</product_class>

        <Modification_History>
            <Modification_Detail>
                <modification_date>2017-01-23</modification_date>
                <version_id>1.0</version_id>
                <description>This is the first version of this product</description>
            </Modification_Detail>
            
            <Modification_Detail>
                <modification_date>2018-12-10</modification_date>
                <version_id>1.1</version_id>
                <description>Updated to include directory structure and new information from the CREMA</description>
            </Modification_Detail>

            <Modification_Detail>
                <modification_date>2019-07-18</modification_date>
                <version_id>1.2</version_id>
                <description>Updated to IM 1B00, changed time format to UTC</description>
            </Modification_Detail>

            <Modification_Detail>
                <modification_date>2025-10-15</modification_date>
                <version_id>1.3</version_id>
                <description>Updated to IM 1M00, updated commissioning and science phase start dates for updated trajectory</description>
            </Modification_Detail>
        </Modification_History>


    </Identification_Area>

    <File_Area_Ancillary>

        <!-- ============================================================== -->
        <!-- File Information                                               -->
        <!-- ============================================================== -->
        <File>
            <file_name>mission_phases.tab</file_name>
            <file_size unit="byte">5120</file_size>
            <md5_checksum>a276121cbab3e1d0e2a25f5e90ebbfbe</md5_checksum>
        </File>

        <Table_Character>
            <name>BepiColombo Mission Phases Table</name>
            <offset unit="byte">128</offset>
            <records>39</records> <!-- number of rows -->
            <description>
                This table is a Character table containing the
                BepiColombo Mission Phases
            </description>
            <record_delimiter>Carriage-Return Line-Feed</record_delimiter>

            <Record_Character>
                <fields>4</fields>
                <groups>0</groups>
                <record_length unit="byte">128</record_length>
                
                <Field_Character>
                    <name>START_TIME_UTC</name>
                    <field_number>1</field_number>
                    <field_location unit="byte">1</field_location>
                    <data_type>ASCII_Date_Time_YMD_UTC</data_type>
                    <field_length unit="byte">25</field_length>
                    <!--field_format>YYYY-MM-DDThh:mm:ss:fffZ</field_format-->
                    <description>
                     UTC timestamp of start of the mission phase
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>MISSION_PHASE_ACRONYM</name>
                    <field_number>2</field_number>
                    <field_location unit="byte">27</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">22</field_length>
                    <description>Mission Phase Acronym</description>
                </Field_Character>
                
                <Field_Character>
                    <name>MISSION_PHASE_NAME</name>
                    <field_number>3</field_number>
                    <field_location unit="byte">50</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">42</field_length>
                </Field_Character>
                
                <Field_Character>
                    <name>PATH_TO_FOLDER</name>
                    <field_number>4</field_number>
                    <field_location unit="byte">94</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">32</field_length>
                    <unit>None</unit>
                </Field_Character>
                
            </Record_Character>
        </Table_Character>
    </File_Area_Ancillary>
</Product_Ancillary>
